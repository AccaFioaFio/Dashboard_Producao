# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assina o cookie de login. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase — Dashboard > Settings > API (projeto NOVO só deste dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: aplicar migrations via CLI
# DATABASE_URL=
# SUPABASE_ACCESS_TOKEN=

# Aviso de corte finalizado (Gmail com senha de app, não a senha de login).
# SMTP_USER=
# SMTP_PASS=
# SMTP_CORTE_TO=operacional4@fioafio.com.br,operacional3@fioafio.com.br,operacional5@fioafio.com.br,jaqueline@fioafio.com.br

# Aviso de corte / costura / revisão via WhatsApp (Evolution API).
# Conecte um número na instância (QR) — esse número é o remetente.
# Costura e revisão usam as mesmas variáveis do corte (lista + instância).
# Depois: ENVIO_WHATSAPP_CORTE_PAUSADO = false em app/actions/corte-producao.ts
#         ENVIO_WHATSAPP_APONTAMENTO_PAUSADO = false em app/actions/apontamento.ts
# WHATSAPP_EVOLUTION_URL=https://sua-evolution.exemplo.com
# WHATSAPP_EVOLUTION_INSTANCE=corte
# WHATSAPP_EVOLUTION_APIKEY=
# WHATSAPP_CORTE_TO=5511999999999,5511888888888

# Planilhas (sinc / ETL). Relativos à raiz ou absolutos neste PC.
# CORTE_XLSX=
# OFICINAS_XLSX=
# SIGNUS_XLS=
# ESTOQUE_XLSX=
# PEDIDOS_XLSX=
# ITENS_XLSX=
# PARCEIROS_XLSX=
