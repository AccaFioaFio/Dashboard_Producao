# Origem real dos Excel (caminhos absolutos se a fábrica grava no OneDrive).
# Relativos são resolvidos na raiz do projeto. Use aspas e barras /.
CORTE_XLSX=Arquivos do Excel/PROGRAMAÇÃO CORTE E COSTURA .xlsx
OFICINAS_XLSX=Arquivos do Excel/Produção Oficinas.xlsx
SIGNUS_XLS=Arquivos do Excel/Movimentação Tecidos.xls

# Obrigatório neste PC para publicar a carga na nuvem (`pnpm carga:publish` / `pnpm carga:watch`).
# Coloque no `.env` ou `.env.local`. Vercel → Storage → Blob. Não commitar o token.
# BLOB_READ_WRITE_TOKEN=

# Na Vercel o token entra sozinho ao conectar o Blob Store.
